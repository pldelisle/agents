{
  "name": "@pldelisle/agent-skills",
  "version": "2.0.0",
  "description": "Configurable installer for Codex, Claude Code, and Kiro agent skills",
  "type": "module",
  "bin": {
    "agent-skills": "bin/agent-skills.js"
  },
  "files": [
    "bin/",
    "lib/",
    "dist/",
    "skills/catalog.json",
    "agent-skills.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
